# Valori da impostare sul server, mai in public/ o su GitHub.
BASE_URL=https://real-villa.onrender.com
PORT=3000
# Solo per prove locali. Su Render usare il percorso del disco persistente.
PAYMENTS_DB_PATH=./payments.db
PAYMENTS_STORAGE_CONFIRMED=false
BACKUP_DIR=

STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_EXPECTED_MONTHLY_CENTS=5000
STRIPE_REGISTRATION_FEE_CENTS=5000
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_RECEIPTS_CONFIGURED=false
LIVE_PAYMENTS_ENABLED=false
# Solo test: simula ingresso a settembre anche prima dell’apertura.
# Richiede STRIPE_MODE=test, sk_test_... e LIVE_PAYMENTS_ENABLED=false.
# Lasciare false nel live: il server rifiuta incassi reali con questa prova attiva.
SANDBOX_EARLY_REGISTRATION=false
# STRIPE_PUBLISHABLE_KEY non serve al Checkout ospitato usato da questo sito.

# Piano approvato per la stagione sportiva 2026-2027.
SEASON_ID=2026-2027
# Il mese d’ingresso si paga intero; i rinnovi sono l’8 fino a maggio.
BILLING_POLICY=calendar_full_months_day8
# Apertura iscrizioni il 1° settembre, senza anticipi ad agosto.
PAYMENT_TERMS_VERSION=2026-2027-sandbox-v4
PAYMENT_TERMS_APPROVED=false

# Segreto casuale di almeno 48 caratteri, generato con un password manager.
AUTH_SECRET=
# Email autorizzate alla consultazione della segreteria, separate da virgola.
ADMIN_EMAILS=
# Su Render Free usare HTTPS con Resend; SMTP 465/587 è bloccato.
MAIL_PROVIDER=resend
RESEND_API_KEY=
MAIL_FROM=
# Alternativa per un server che consente SMTP: impostare MAIL_PROVIDER=smtp.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# PayPal non viene eliminato. Gli abbonamenti esistenti continuano su PayPal.
# Le nuove iscrizioni offrono carta e PayPal NEL CHECKOUT STRIPE.
# Non richiedono queste vecchie chiavi PayPal: attivare PayPal nel pannello Stripe.
# Riattivare lo shop PayPal solo dopo il suo collaudo separato.
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SUBSCRIPTION_PLAN_ID=
PAYPAL_WEBHOOK_ID=
