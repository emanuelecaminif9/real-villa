BASE_URL=http://localhost:3000
PORT=3000
PAYMENTS_DB_PATH=./payments.db

# PayPal: usa sandbox durante i test e live in produzione
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=inserisci_client_id
PAYPAL_CLIENT_SECRET=inserisci_client_secret
PAYPAL_SUBSCRIPTION_PLAN_ID=inserisci_plan_id_generato
PAYPAL_WEBHOOK_ID=inserisci_webhook_id

# Stripe: le chiavi sk_test/pubblicabile sono di prova; usare le chiavi live
# solo dopo aver completato tutti i test e la verifica dell'account Business.
STRIPE_SECRET_KEY=sk_test_inserisci_chiave_segreta
STRIPE_PUBLISHABLE_KEY=pk_test_inserisci_chiave_pubblicabile
STRIPE_WEBHOOK_SECRET=whsec_inserisci_segreto_webhook
STRIPE_SUBSCRIPTION_PRICE_ID=price_inserisci_piano_mensile
