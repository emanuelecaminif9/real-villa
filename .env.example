# Valori da impostare sul server, mai in public/ o su GitHub.
BASE_URL=https://real-villa.onrender.com
PORT=3000
# Solo per prove locali. Su Render usare il percorso del disco persistente.
PAYMENTS_DB_PATH=./payments.db
PAYMENTS_STORAGE_CONFIRMED=false
BACKUP_DIR=

STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUBSCRIPTION_PRICE_ID=
STRIPE_EXPECTED_MONTHLY_CENTS=5000
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_RECEIPTS_CONFIGURED=false
LIVE_PAYMENTS_ENABLED=false
# STRIPE_PUBLISHABLE_KEY non serve al Checkout ospitato usato da questo sito.

# Le date e le regole NON sono inventate: confermarle con la società.
SEASON_ID=2026-2027
# Esempio di FORMATO, non una data approvata: 2027-06-30T23:59:59+02:00
SEASON_END_AT=
# Modalità implementata: anniversary_prorated_end
# Rinnovi nel giorno dell'iscrizione; ultimo periodo eventualmente proporzionale.
# Se i soci vogliono un giorno uguale per tutti o rate sempre intere, adeguare prima il codice.
BILLING_POLICY=
PAYMENT_TERMS_VERSION=
PAYMENT_TERMS_APPROVED=false

# Segreto casuale di almeno 48 caratteri, generato con un password manager.
AUTH_SECRET=
# Email autorizzate alla consultazione della segreteria, separate da virgola.
ADMIN_EMAILS=
# Servizio email transazionale con TLS (465 oppure 587).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# PayPal non viene eliminato. Gli abbonamenti esistenti continuano su PayPal.
# Le nuove iscrizioni stagionali utilizzano Stripe.
# Riattivare lo shop PayPal solo dopo il suo collaudo separato.
PAYPAL_CHECKOUT_ENABLED=false
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SUBSCRIPTION_PLAN_ID=
PAYPAL_WEBHOOK_ID=
